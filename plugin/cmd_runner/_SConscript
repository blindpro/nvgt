Import("env", "nvgt_env")

if ARGUMENTS.get("no_shared_plugins", "0") == "0":
    env.SharedLibrary("#release/lib/cmd_runner", ["cmd_runner.cpp"])

static_obj = env.Object("cmd_runner_static", "cmd_runner.cpp", CPPDEFINES = [("NVGT_PLUGIN_STATIC", "cmd_runner")])
static_lib = env.StaticLibrary("#build/lib/cmd_runner", [static_obj])
Return("static_lib")
